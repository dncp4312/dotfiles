#!/bin/sh

host=$(sudo find /var/lib/bluetooth -maxdepth 1 -type d -name '*:*:*:*:*:*' -printf '%f\n' | head -n1)
dev=$(bluetoothctl devices | grep -i XM5 | awk '{print $2}' | head -1)
dst="/var/lib/bluetooth/$host/$dev/info"

sudo mkdir -p "$(dirname "$dst")"

envsubst <<EOF | sudo tee "$dst" >/dev/null
[General]
Name=WH-1000XM5
Class=0x240404
SupportedTechnologies=BR/EDR;
Trusted=true
Blocked=false
CablePairing=false
Services=00000000-deca-fade-deca-deafdecacaff;00001108-0000-1000-8000-00805f9b34fb;0000110b-0000-1000-8000-00805f9b34fb;0000110c-0000-1000-8000-00805f9b34fb;0000110d-0000-1000-8000-00805f9b34fb;0000110e-0000-1000-8000-00805f9b34fb;0000110f-0000-1000-8000-00805f9b34fb;0000111e-0000-1000-8000-00805f9b34fb;00001124-0000-1000-8000-00805f9b34fb;00001131-0000-1000-8000-00805f9b34fb;00001200-0000-1000-8000-00805f9b34fb;45c93e07-d90d-4b93-a9db-91e5dd734e35;764cbf0d-bbcb-438f-a8bb-6b92759d6053;81c2e72a-0591-443e-a1ff-05f988593351;8901dfa8-5c7e-4d8f-9f0c-c2b70683f5f0;931c7e8a-540f-4686-b798-e8df0a2ad9f7;956c7b26-d49a-4ba8-b03f-b17d393cb6e2;9b26d8c0-a8ed-440b-95b0-c4714a518bcc;df21fe2c-2515-4fdb-8886-f12c4d67927c;f76acb00-7cab-495f-bb1a-e664598fd77f;f7a96061-a1b3-40de-aff0-e78ec45a151e;f8d1fbe4-7966-4334-8024-ff96c9330e15;
WakeAllowed=true
Alias=Vanity

[DeviceID]
Source=2
Vendor=1356
Product=3568
Version=577

[LinkKey]
Key=$VANITY_LINKKEY
Type=4
PINLength=0
EOF

sudo systemctl restart bluetooth
