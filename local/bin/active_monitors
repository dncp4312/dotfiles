#!/usr/bin/env zsh

state_file="${XDG_CACHE_HOME:-$HOME/.cache}/bspwm-monitor-layout"

case "$1" in
  h|v) layout="$1" ;;
  *)   layout=${$(<"$state_file" 2>/dev/null):-v} ;;
esac

case "$layout" in
  h) PREFERRED_ORDER=(eDP-1 DP-1) ;;
  v) PREFERRED_ORDER=(DP-1 eDP-1) ;;
esac

[[ $1 == s ]] && PREFERRED_ORDER=("${(Oa)PREFERRED_ORDER}")

active_monitors=$(xrandr | awk '/ connected/ {print $1}' | while read -r mon; do
    xrandr | awk -v mon="$mon" '
        $0 ~ "^" mon " connected" { in_block = 1; next }
        in_block && /^[[:space:]]+[0-9]+x[0-9]+/ && /\+/ { exit 0 }
        in_block && NF == 0 { exit 1 }
    ' && echo "$mon"
done)

for monitor in "${PREFERRED_ORDER[@]}"; { echo "$active_monitors" | grep -Fx "$monitor" }
echo "$active_monitors" | grep -vFx "$(printf '%s\n' "${PREFERRED_ORDER[@]}")"
